    {
      "name": "download_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"download_groups\" (\"id\" TEXT NOT NULL, \"playlist_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"channel\" TEXT NULL, \"sub_dir\" TEXT NULL, \"total\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "download_tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"download_tasks\" (\"id\" TEXT NOT NULL, \"group_id\" TEXT NULL REFERENCES download_groups (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"playlist_index\" INTEGER NULL, \"source_url\" TEXT NOT NULL, \"video_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"channel\" TEXT NOT NULL, \"duration_ms\" INTEGER NULL, \"thumb_url\" TEXT NULL, \"format_json\" TEXT NOT NULL, \"format_key\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"pause_reason\" TEXT NULL, \"failure_type\" TEXT NULL, \"failure_debug\" TEXT NULL, \"attempt\" INTEGER NOT NULL DEFAULT 0, \"not_before\" INTEGER NULL, \"output_path\" TEXT NULL, \"transport\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "task_legs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_legs\" (\"task_id\" TEXT NOT NULL REFERENCES download_tasks (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"itag\" INTEGER NULL, \"ext\" TEXT NULL, \"url\" TEXT NULL, \"url_expires_at\" INTEGER NULL, \"total_bytes\" INTEGER NULL, \"done_bytes\" INTEGER NOT NULL DEFAULT 0, \"tmp_path\" TEXT NOT NULL, \"transport_ref\" TEXT NULL, \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), PRIMARY KEY (\"task_id\", \"kind\"));"
        }
      ]
    },
    {
      "name": "task_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" TEXT NOT NULL REFERENCES download_tasks (id) ON DELETE CASCADE, \"type\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"args_json\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "library_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_items\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NULL UNIQUE, \"video_id\" TEXT NOT NULL, \"source_url\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"channel\" TEXT NOT NULL, \"search_norm\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"container\" TEXT NOT NULL, \"height\" INTEGER NULL, \"duration_ms\" INTEGER NULL, \"path\" TEXT NOT NULL UNIQUE, \"bytes\" INTEGER NOT NULL, \"thumb_path\" TEXT NULL, \"completed_at\" INTEGER NOT NULL, \"missing\" INTEGER NOT NULL DEFAULT 0 CHECK (\"missing\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL, \"save_directory\" TEXT NULL, \"default_kind\" TEXT NOT NULL, \"default_max_height\" INTEGER NOT NULL, \"audio_kbps\" INTEGER NOT NULL, \"max_concurrent\" INTEGER NOT NULL, \"name_template\" TEXT NOT NULL, \"playlist_subfolders\" INTEGER NOT NULL CHECK (\"playlist_subfolders\" IN (0, 1)), \"wifi_only\" INTEGER NOT NULL CHECK (\"wifi_only\" IN (0, 1)), \"clipboard_watch\" INTEGER NOT NULL CHECK (\"clipboard_watch\" IN (0, 1)), \"notifications\" INTEGER NOT NULL CHECK (\"notifications\" IN (0, 1)), \"theme\" TEXT NOT NULL, \"language_code\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (max_concurrent BETWEEN 1 AND 5));"
