# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- Tube Downloader ---
# Generated code is rebuilt by CI (build_runner, gen-l10n), never committed.
*.g.dart
*.freezed.dart
lib/l10n/app_localizations*.dart
# Secrets and signing material (review-gate also blocks these).
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.pfx
key.properties
# Test / coverage output and partial downloads from local runs.
coverage/
*.part
# Phase-0 spike build output.
spike/**/build/
spike/**/.dart_tool/
# Gradle writes reports here (e.g. problems-report.html); never source.
/android/build/
